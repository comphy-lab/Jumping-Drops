#!/bin/bash

# Example Basilisk environment configuration
# You can generate a real .project_config by running:
#   ./reset_install_requirements.sh
# If Basilisk lives elsewhere, edit BASILISK below.

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export BASILISK="${PROJECT_ROOT}/basilisk/src"
export PATH="$PATH:$BASILISK"
